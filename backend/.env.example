# TourismToolKit backend configuration.
#
#   cp backend/.env.example backend/.env
#
# docker-compose loads this file into the backend container. Its absence is the
# root cause of the "everything runs but no AI feature works" failure mode: the
# BASHINI_* variables below are the only way the app learns its upstream endpoints.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG surfaces upstream request/response detail
DEBUG=false

DATABASE_URL=postgresql+psycopg://tourism_user:tourism_password@localhost:5432/tourism_db
DB_ECHO=false                     # true logs every SQL statement
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Outside production an unset value produces an ephemeral key (all sessions drop
# on restart); in production startup fails rather than signing with a known key.
# `SECRET_KEY` is accepted as a legacy alias.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days, matching the frontend auth cookie

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Origins only - scheme://host[:port], never a path. A browser's Origin header
# has no path, so `https://example.com/graphql` would match nothing; a path is
# stripped with a warning rather than left silently inert.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Vercel gives every preview deployment its own hostname, which no fixed list can
# cover. Uncomment to allow them all:
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
GRAPHQL_IDE=true                   # forced off in production

# ---------------------------------------------------------------------------
# Bhashini / Canvas upstream services
# ---------------------------------------------------------------------------
# Endpoints follow a regular scheme and are discovered automatically:
#
#   BASHINI_<SERVICE>_API_URL_<LANG>     BASHINI_<SERVICE>_API_TOKEN_<LANG>
#   BASHINI_MT_API_URL_<SRC>_<TGT>       BASHINI_MT_API_TOKEN_<SRC>_<TGT>
#   BASHINI_<SERVICE>_API_URL_DEFAULT    (fallback for that service)
#   BASHINI_API_TOKEN_DEFAULT            (fallback token for every service)
#
# SERVICE is one of ASR, TTS, OCR, MT. Adding a language needs no code change.
# (The BHASHINI_ spelling is also accepted.)

BASHINI_API_TOKEN_DEFAULT=

# --- Machine translation (language pairs) ---
BASHINI_MT_API_URL_DEFAULT=
BASHINI_MT_API_URL_EN_HI=
BASHINI_MT_API_TOKEN_EN_HI=
BASHINI_MT_API_URL_EN_TE=
BASHINI_MT_API_TOKEN_EN_TE=
BASHINI_MT_API_URL_EN_TA=
BASHINI_MT_API_TOKEN_EN_TA=
BASHINI_MT_API_URL_EN_KN=
BASHINI_MT_API_TOKEN_EN_KN=

# --- Text to speech ---
BASHINI_TTS_API_URL_DEFAULT=
BASHINI_TTS_API_URL_EN=
BASHINI_TTS_API_TOKEN_EN=
BASHINI_TTS_API_URL_HI=
BASHINI_TTS_API_TOKEN_HI=
BASHINI_TTS_API_URL_GU=
BASHINI_TTS_API_TOKEN_GU=
BASHINI_TTS_API_URL_MR=
BASHINI_TTS_API_TOKEN_MR=

# --- Speech recognition (en hi te ta kn ml bn gu mr pa) ---
BASHINI_ASR_API_URL_EN=
BASHINI_ASR_API_TOKEN_EN=
BASHINI_ASR_API_URL_HI=
BASHINI_ASR_API_TOKEN_HI=
BASHINI_ASR_API_URL_TE=
BASHINI_ASR_API_TOKEN_TE=
BASHINI_ASR_API_URL_TA=
BASHINI_ASR_API_TOKEN_TA=
BASHINI_ASR_API_URL_KN=
BASHINI_ASR_API_TOKEN_KN=
BASHINI_ASR_API_URL_ML=
BASHINI_ASR_API_TOKEN_ML=
BASHINI_ASR_API_URL_BN=
BASHINI_ASR_API_TOKEN_BN=
BASHINI_ASR_API_URL_GU=
BASHINI_ASR_API_TOKEN_GU=
BASHINI_ASR_API_URL_MR=
BASHINI_ASR_API_TOKEN_MR=
BASHINI_ASR_API_URL_PA=
BASHINI_ASR_API_TOKEN_PA=

# --- OCR (en hi te ta kn ml bn gu mr pa) ---
BASHINI_OCR_API_URL_EN=
BASHINI_OCR_API_TOKEN_EN=
BASHINI_OCR_API_URL_HI=
BASHINI_OCR_API_TOKEN_HI=
BASHINI_OCR_API_URL_TE=
BASHINI_OCR_API_TOKEN_TE=
BASHINI_OCR_API_URL_TA=
BASHINI_OCR_API_TOKEN_TA=
BASHINI_OCR_API_URL_KN=
BASHINI_OCR_API_TOKEN_KN=
BASHINI_OCR_API_URL_ML=
BASHINI_OCR_API_TOKEN_ML=
BASHINI_OCR_API_URL_BN=
BASHINI_OCR_API_TOKEN_BN=
BASHINI_OCR_API_URL_GU=
BASHINI_OCR_API_TOKEN_GU=
BASHINI_OCR_API_URL_MR=
BASHINI_OCR_API_TOKEN_MR=
BASHINI_OCR_API_URL_PA=
BASHINI_OCR_API_TOKEN_PA=

# --- Upstream transport ---
# Both known upstream hosts (canvas.iiit.ac.in, dhruva-api.bhashini.gov.in) serve
# valid publicly-trusted chains, so verification should stay on. If you ever hit a
# chain problem, add the missing CA via BHASHINI_CA_BUNDLE - it is loaded *in
# addition to* the public roots - rather than disabling verification, which would
# expose the access tokens these requests carry.
BHASHINI_VERIFY_SSL=true
# BHASHINI_CA_BUNDLE=/app/certs/extra-ca.pem
BHASHINI_TIMEOUT=30
BHASHINI_CONNECT_TIMEOUT=5
BHASHINI_MAX_RETRIES=2
BHASHINI_MAX_UPLOAD_BYTES=10485760   # 10 MB cap on base64 audio/image uploads

# ---------------------------------------------------------------------------
# Startup
# ---------------------------------------------------------------------------
SEED_DB=false                      # true seeds starter content on container start
